PORT=3001

# OpenAI — ключ на platform.openai.com (нужна привязанная карта, тарификация по токенам)
OPENAI_API_KEY=

# Telegram-бот — создаётся бесплатно за 2 минуты через @BotFather в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Свой пароль для просмотра списка заявок через GET /api/leads
ADMIN_API_KEY=change-me

# Meta Ads — появляются после верификации Business Manager на developers.facebook.com
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
